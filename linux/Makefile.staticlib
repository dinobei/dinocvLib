# dinocvLib AMAZON-II º¸µå Static Library Makefile

CROSS_COMPILE 	= #ae32000-elf-uclibc-

AS		= $(CROSS_COMPILE)as
LD		= $(CROSS_COMPILE)ld
CC		= $(CROSS_COMPILE)gcc
CPP		= $(CROSS_COMPILE)g++
AR		= $(CROSS_COMPILE)ar
NM		= $(CROSS_COMPILE)nm
STRIP	= $(CROSS_COMPILE)strip
OBJCOPY	= $(CROSS_COMPILE)objcopy
OBJDUMP	= $(CROSS_COMPILE)objdump
RANLIB	= $(CROSS_COMPILE)ranlib
ELF2FLT	= $(CROSS_COMPILE)elf2flt
STRIP		= $(CROSS_COMPILE)strip

CFLAGS	= -O2 -Wall -Dlinux -D__linux__ -Dunix -D__uClinux__ -DEMBED

COMPILER_PREFIX=/usr/local/ae32000-elf-uclibc-tools
LDFLAGS = -r -Xlinker -T$(COMPILER_PREFIX)/lib/ae32000-elf2flt.ld
LDFLAGS_DBG = -Xlinker -T$(COMPILER_PREFIX)/lib/ae32000-elf2flt.ld

LDLIBS	= -lm -lc -lpthread


LIB_SRCS = ../source/dinocore/imgcore.cpp\
../source/dinocore/bmpanal.cpp\
../source/dinocore/imgdraw.cpp\
../source/dinocore/imgconv.cpp\
../source/dinocore/ppmanal.cpp\
../source/dinocore/imageio.cpp\
../source/dinods/ds_sort.cpp\
../source/dinods/linkedlist.cpp\
../source/dinods/queue.cpp\
../source/dinoproc/binarization.cpp\
../source/dinoproc/dp.cpp\
../source/dinoproc/filter.cpp\
../source/dinoproc/cannyedge.cpp\
../source/dinoproc/chaincode.cpp\
../source/dinoproc/convexhull.cpp\
../source/dinoproc/labeling.cpp\
../source/dinoproc/feature.cpp\
../source/dinoproc/histogram.cpp\
../source/dinoproc/morphology.cpp\
../source/dinoproc/resize.cpp\
../source/dinoproc/thinning.cpp\
../source/dinomm/memmgr.cpp

LIB_OBJS = $(LIB_SRCS:.cpp=.o)
LIB_HDRS = $(LIB_SRCS:.cpp=.h)

OUTPUT_PATH = /usr/local/lib/
DINOCVLIB = $(OUTPUT_PATH)libdinocv.a

export AS LD CC CPP AR NM STRIP OBJCOPY OBJDUMP RANLIB CFLAGS




all: $(DINOCVLIB)

$(DINOCVLIB): $(LIB_OBJS)

	$(AR) ruv $(DINOCVLIB) $(LIB_OBJS)

.cpp.o:
	$(CPP) $(CFLAGS) -c $< -o $@

.s.o:
	$(AS) $< -o $@
	

clean:
	rm -f dinocore/*.o dinoproc/*.o dinods/*.o dinomm/*.o $(DINOCVLIB)
